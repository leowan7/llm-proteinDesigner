# ============================================================================
# Kendrew .env.example — Phase 11 D-11 full audit
# ============================================================================
# Every key below is required somewhere in prod. Comments denote the runtime
# that consumes each key, per D-12 scoping matrix (docs/deploy.md — Plan 11-05).
#
# DO NOT commit real values. Copy to .env.local for dev; for prod, paste into
# Railway Variables / Vercel Env Vars / Modal Secrets.
# ============================================================================

# ------------------ Supabase (Auth + Postgres) ------------------
# runtime: Backend (Railway). Frontend uses ONLY VITE_SUPABASE_URL + anon key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from supabase status>
# NEVER put SUPABASE_SERVICE_ROLE_KEY in Vercel — backend only.
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>
SUPABASE_JWT_SECRET=<from supabase status>

# runtime: Backend + Worker (Railway). Supavisor transaction pooler in prod (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------ Object Storage (Cloudflare R2 in prod, MinIO local) ------------------
# runtime: Backend + Worker (Railway). Also Modal apps via modal secret kendrew-r2.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=protein-designer

# ------------------ Redis (Upstash TLS in prod) ------------------
# runtime: Backend + Worker (Railway). rediss:// required in prod.
REDIS_URL=redis://redis:6379/0

# ------------------ Session / CSRF / Cookies ------------------
# runtime: Backend (Railway). Set COOKIE_SECURE=true in prod.
CSRF_SECRET=change-me-in-production
COOKIE_SECURE=false

# runtime: Backend (Railway). Exact match list — CORS hardened per D-12.
CORS_ORIGINS=["http://localhost:5173"]

# ------------------ App flags ------------------
# runtime: Backend (Railway). DEBUG=false in prod (disables /debug/sentry-test).
DEBUG=true
TESTING=false

# ------------------ Sentry ------------------
# runtime: Backend (Railway). Frontend uses VITE_SENTRY_DSN_FRONTEND (Vercel).
SENTRY_DSN=
# runtime: Frontend (Vercel). Separate browser project DSN.
VITE_SENTRY_DSN_FRONTEND=

# ------------------ Rate limiting ------------------
# runtime: Backend (Railway).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute

# ------------------ Anthropic (Claude agent) ------------------
# runtime: Backend (Railway). NEVER expose in Vercel.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ------------------ Stripe ------------------
# runtime: Backend (Railway). Live keys in prod, test keys in staging.
STRIPE_SECRET_KEY=sk_test_or_sk_live
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_METER_EVENT_NAME=gpu_seconds
# runtime: Frontend (Vercel).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live

# ------------------ GPU Provider (Modal primary, per Phase 10) ------------------
# runtime: Backend + Worker (Railway).
GPU_PROVIDER=modal

# ------------------ Modal ------------------
# runtime: Backend + Worker (Railway) + CI (GitHub Actions secrets).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WORKSPACE=
MODAL_ENVIRONMENT=main

# ------------------ RunPod (quarantined emergency fallback) ------------------
# runtime: Backend + Worker (Railway). Only used when GPU_PROVIDER=runpod_emergency.
RUNPOD_API_KEY=
# DEPRECATED alias for WEBHOOK_HMAC_SECRET — see Phase 11 D-10 / Plan 11-04.
RUNPOD_WEBHOOK_SECRET=

# ------------------ Webhook HMAC (Phase 11 D-10 dual-secret rotation) ------------------
# runtime: Backend (Railway). Single shared secret for both Modal and RunPod webhooks.
# Rotation runbook: docs/deploy.md.
WEBHOOK_HMAC_SECRET=
WEBHOOK_HMAC_SECRET_PREV=

# ------------------ Resend (transactional email) ------------------
# runtime: Backend + Worker (Railway).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kendrew.AI <jobs@kendrew.ai>

# ------------------ App base URL ------------------
# runtime: Backend (Railway) — for email links + Stripe return URLs.
APP_BASE_URL=http://localhost:8000
# runtime: Frontend (Vercel).
VITE_APP_BASE_URL=http://localhost:8000
# runtime: Frontend (Vercel).
VITE_SUPABASE_URL=http://127.0.0.1:54321
# runtime: Frontend (Vercel).
VITE_SUPABASE_ANON_KEY=<from supabase status>

# ------------------ Upload URL expiry ------------------
# runtime: Backend (Railway).
UPLOAD_URL_EXPIRY_SECONDS=3600

# ------------------ GPU spend alerting (Phase 11 D-16) ------------------
# runtime: Worker (Railway). Cron in worker/cleanup.py::check_daily_gpu_spend.
GPU_DAILY_SPEND_ALERT_USD=50.0

# ------------------ SSE limits ------------------
# runtime: Backend (Railway).
MAX_SSE_CONNECTIONS_PER_USER=3

# ------------------ GPU pricing (cost calc) ------------------
# runtime: Backend (Railway).
GPU_PRICE_PER_SECOND=0.0000917
GPU_MARKUP_PERCENT=30.0

# ------------------ External APIs ------------------
# runtime: Backend (Railway).
RCSB_BASE_URL=https://files.rcsb.org
UNIPROT_BASE_URL=https://rest.uniprot.org

# ------------------ Agent ------------------
# runtime: Backend (Railway).
AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_TOKENS=2048
AGENT_SESSION_TTL_SECONDS=3600

# ------------------ Legal / Compliance (Phase 10) ------------------
# runtime: Backend (Railway).
TOS_CURRENT_VERSION=2026-04-23
PRIVACY_CURRENT_VERSION=2026-04-23
