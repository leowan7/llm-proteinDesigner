# Supabase (values from `supabase status` after `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>
SUPABASE_JWT_SECRET=<from supabase status>

# Database (Supabase local Postgres -- override for Docker networking)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# S3 / MinIO (local) / Cloudflare R2 (prod)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=protein-designer

# Redis
REDIS_URL=redis://redis:6379/0

# CSRF
CSRF_SECRET=change-me-in-production
COOKIE_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# App
DEBUG=true
TESTING=false
