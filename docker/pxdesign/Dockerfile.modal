# Modal variant of docker/pxdesign/Dockerfile.
# Diff vs production:
#   - `wget -q --show-progress` (AF2, CCD, clusters) -> `curl -fsSL --retry 5 --retry-delay 10`
#   - No COPY run_pipeline.py; no CMD; no WORKDIR /opt.
# PXDesign requires CUDA 12.1+ and Python >=3.10. Devel image for CUTLASS + DeepSpeed kernels.
FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PXDESIGN_DIR=/opt/pxdesign \
    CUTLASS_PATH=/opt/cutlass

# ---------- System deps (resilient against Modal->Ubuntu archive blips) ----------
# 2026-05-04: two consecutive `modal deploy` runs failed at this step with
# "Unable to connect to archive.ubuntu.com:80" across all 8 round-robin IPs
# (91.189.91.x / 185.125.190.x — Canonical's primary archive pool). Modal's
# egress to that pool was broken for >15 minutes. Three layers of defense:
#   1. Repoint sources.list to mirrors.kernel.org (kernel.org infra, not
#      Canonical's). Different IP space, different network path.
#   2. Configure apt to retry inside each get/install call (Acquire::Retries).
#   3. Wrap apt-get with a bash retry loop + exponential backoff so a single
#      mirror blip doesn't kill the build.
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.kernel.org/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.kernel.org/ubuntu|g' /etc/apt/sources.list && \
    printf 'Acquire::Retries "10";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/80retries && \
    cat /etc/apt/sources.list

RUN attempt=0; \
    until apt-get update && apt-get install -y --no-install-recommends --fix-missing \
            curl git cmake python3-pip python3-dev build-essential libffi-dev; do \
      attempt=$((attempt+1)); \
      if [ $attempt -ge 5 ]; then echo "apt-get failed after 5 attempts" && exit 1; fi; \
      echo "apt-get attempt $attempt failed, retrying in $((attempt*30))s"; \
      sleep $((attempt*30)); \
    done && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    rm -rf /var/lib/apt/lists/*

# ---------- PyTorch 2.3.1 (CUDA 12.1) ----------
RUN python3 -m pip install --no-cache-dir \
    torch==2.3.1 --index-url https://download.pytorch.org/whl/cu121

# ---------- CUTLASS v3.5.1 (header-only, for DeepSpeed Evo attention) ----------
RUN git clone --depth 1 --branch v3.5.1 \
    https://github.com/NVIDIA/cutlass.git $CUTLASS_PATH

# ---------- Clone PXDesign (PINNED 2026-04-29) ----------
# Pinned to upstream HEAD as of 2026-04-29 to stop further drift after the
# 2026-04-28 mini_pilot regression (see VALIDATION-LOG.md). If mini_pilot
# performance does not recover with the run_pipeline.py timeout bump alone,
# replace this SHA with the upstream commit that was current on 2026-04-22
# when the 918s mini_pilot baseline was established.
ARG PXDESIGN_SHA=f788441313c84c3074fe9596ac2433f96b15c763
RUN git clone https://github.com/bytedance/PXDesign.git $PXDESIGN_DIR && \
    cd $PXDESIGN_DIR && git checkout $PXDESIGN_SHA && \
    echo "PXDesign pinned to $(git rev-parse HEAD)"

# ---------- Install PXDesign deps ----------
RUN pip --no-cache-dir install git+https://github.com/bytedance/Protenix.git@v0.5.0+pxd

# ColabDesign (PINNED 2026-04-29) — same drift-stop rationale.
ARG COLABDESIGN_SHA=e31a56fe1d9b4de25c8697f3a28b75892941cc72
RUN pip install --no-cache-dir "git+https://github.com/sokrypton/ColabDesign.git@${COLABDESIGN_SHA}" --no-deps && \
    pip install --no-cache-dir \
    posix_ipc einops transformers==4.51.3 optax==0.2.5 dm-haiku==0.0.13

RUN pip install --no-cache-dir "jax[cuda12]==0.4.29" && \
    python3 -c "import jax; print('jax', jax.__version__, 'cuda plugin installed')"
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}

# Verify torch still imports cleanly after the JAX install may have pulled
# cuDNN 9 into site-packages. Torch 2.3.1's bundled cuDNN 8.9 is loaded via
# earlier ld search order so this should be safe.
RUN python3 -c "import torch; assert torch.cuda.is_available() or True; print('torch', torch.__version__, 'import OK')"

RUN pip install --no-cache-dir \
    numpy==1.26.3 natsort dm-tree \
    biopython==1.83 modelcif==0.7 biotite==1.0.1 \
    scipy scikit-learn scikit-learn-extra \
    "deepspeed>=0.12.0,<0.13.0" protobuf==3.20.2 \
    matplotlib==3.9.2 rdkit-pypi \
    pyyaml ml_collections tqdm pandas

RUN pip install --no-cache-dir git+https://github.com/bytedance/PXDesignBench.git@v0.1.2 --no-deps

RUN cd $PXDESIGN_DIR && pip install --no-cache-dir -e .

# ---------- Enforce torch==2.3.1 + deepspeed<0.13 after all installs ----------
# Protenix and PXDesign's own setup.py (`pip install -e .`) upgrade torch
# AND deepspeed during their install. deepspeed >=0.14 uses
# torch.amp.custom_fwd(device_type=...) which only exists in torch 2.4+;
# at torch 2.3.1 the import fails with:
#   AttributeError: module 'torch.amp' has no attribute 'custom_fwd'
# Force both torch 2.3.1 AND deepspeed 0.12.x back here so the runtime
# matches the Dockerfile header.
RUN pip install --force-reinstall --no-cache-dir \
    torch==2.3.1 --index-url https://download.pytorch.org/whl/cu121 && \
    pip install --force-reinstall --no-cache-dir --no-deps \
    "deepspeed>=0.12.0,<0.13.0" && \
    python3 -c "import torch, deepspeed; print('torch', torch.__version__, 'deepspeed', deepspeed.__version__)"

# ============================================================================
# !!! DO NOT MOVE OR REORDER THIS BLOCK !!!
# This RUN must come AFTER every torch install above and BEFORE any step that
# imports JAX. If you reorder it, reinstall torch later, or remove the
# `--no-deps` flag, PXDesign will silently fall back to cuDNN 8 and hang for
# ~28 minutes on the first JAX call (Bug-8-shape failure).
# ============================================================================
# torch==2.3.1 depends on nvidia-cudnn-cu12==8.9.2.26 and re-installing torch
# pulls cuDNN 8 back into /usr/local/lib/python3.10/dist-packages/nvidia/cudnn/lib/,
# overwriting the cuDNN 9.1.1.17 that jax[cuda12]==0.4.29 needs. Force cuDNN
# 9.1.1.17 again with --no-deps so jaxlib can find a matching DNN library.
# torch will still find cuDNN 9 too, but torch is used only in subprocesses that
# don't share a process with JAX.
RUN pip install --no-cache-dir --force-reinstall --no-deps \
        "nvidia-cudnn-cu12==9.1.1.17" && \
    ls -la /usr/local/lib/python3.10/dist-packages/nvidia/cudnn/lib/ | head -20 && \
    python3 -c "import ctypes; ctypes.CDLL('libcudnn.so.9'); print('libcudnn.so.9 loadable')"

# ---------- Download tool weights (AF2, ProteinMPNN, CCD cache) — PATCHED ----------
# AF2 weights (Google Cloud — global)
RUN mkdir -p $PXDESIGN_DIR/tool_weights/af2 && \
    curl -fsSL --retry 5 --retry-delay 10 \
        "https://storage.googleapis.com/alphafold/alphafold_params_2022-12-06.tar" \
        -o /tmp/af2_params.tar && \
    tar -xf /tmp/af2_params.tar -C $PXDESIGN_DIR/tool_weights/af2 && \
    rm /tmp/af2_params.tar && \
    echo "AF2 weights OK: $(ls $PXDESIGN_DIR/tool_weights/af2/ | wc -l) files"

# ProteinMPNN weights (GitHub — global)
RUN mkdir -p $PXDESIGN_DIR/tool_weights/mpnn && \
    git clone --depth 1 https://github.com/dauparas/ProteinMPNN.git /tmp/ProteinMPNN && \
    cp -r /tmp/ProteinMPNN/ca_model_weights $PXDESIGN_DIR/tool_weights/mpnn/ && \
    cp -r /tmp/ProteinMPNN/vanilla_model_weights $PXDESIGN_DIR/tool_weights/mpnn/ && \
    rm -rf /tmp/ProteinMPNN && \
    echo "ProteinMPNN weights OK"

# CCD cache (wwPDB — global; China CDN in production Dockerfile is unreachable from Modal)
RUN mkdir -p $PXDESIGN_DIR/tool_weights/ccd && \
    curl -fsSL --retry 5 --retry-delay 10 \
        "https://files.wwpdb.org/pub/pdb/data/monomers/components.cif.gz" \
        -o $PXDESIGN_DIR/tool_weights/ccd/components.cif.gz && \
    gunzip $PXDESIGN_DIR/tool_weights/ccd/components.cif.gz && \
    echo "CCD source: $(du -sh $PXDESIGN_DIR/tool_weights/ccd/components.cif)" && \
    curl -fsSL --retry 5 --retry-delay 10 \
        "https://cdn.rcsb.org/resources/sequence/clusters/clusters-by-entity-40.txt" \
        -o $PXDESIGN_DIR/tool_weights/ccd/clusters-by-entity-40.txt && \
    echo "Clusters file OK"

# Validate weights
RUN echo "=== Weight validation ===" && \
    ls -lh $PXDESIGN_DIR/tool_weights/af2/ && \
    ls -lh $PXDESIGN_DIR/tool_weights/mpnn/ && \
    ls -lh $PXDESIGN_DIR/tool_weights/ccd/ && \
    echo "Weight download complete"

# ---------- Pre-bake pxdesign inference cache (incident 2026-05-04 c8eba974) ----------
# pxdesign/utils/infer.py:download_inference_cache() downloads 7 files from
# pxdesign.tos-cn-beijing.volces.com on first runtime invocation. urllib's
# urlretrieve has zero retry support; on 2026-05-04 a TLS UNEXPECTED_EOF at
# 98% killed a paying pilot run with no recovery path.
#
# Fix: pre-fetch all 7 files at image build time using curl with aggressive
# retries. infer.py guards every download with `if not os.path.exists(...)`,
# so pre-baked files skip the runtime download entirely. Use `.tmp` + atomic
# rename so a build-time failure can't leave partial files that pass the
# existence check at runtime.
#
# Default paths (per upstream README):
#   model checkpoints -> $PXDESIGN_DIR/release_data/checkpoint/
#   data caches       -> $PXDESIGN_DIR/release_data/ccd_cache/
# pxdesign resolves load_checkpoint_dir relative to its own working dir,
# which run_pipeline.py:1001 sets to PXDESIGN_DIR via cwd=PXDESIGN_DIR.
RUN mkdir -p $PXDESIGN_DIR/release_data/checkpoint && \
    cd $PXDESIGN_DIR/release_data/checkpoint && \
    for f in pxdesign_v0.1.0.pt protenix_base_default_v0.5.0.pt \
             protenix_mini_default_v0.5.0.pt protenix_mini_tmpl_v0.5.0.pt; do \
      echo ">>> baking checkpoint: $f" && \
      curl -fL --retry 15 --retry-delay 20 --retry-max-time 1800 --retry-all-errors \
        --connect-timeout 30 \
        -o "$f.tmp" \
        "https://pxdesign.tos-cn-beijing.volces.com/release_model/$f" && \
      mv "$f.tmp" "$f" && \
      echo "$f: $(du -h "$f" | cut -f1)"; \
    done && \
    echo "Inference checkpoints baked: $(ls -lh $PXDESIGN_DIR/release_data/checkpoint/)"

RUN mkdir -p $PXDESIGN_DIR/release_data/ccd_cache && \
    cd $PXDESIGN_DIR/release_data/ccd_cache && \
    for f in components.v20240608.cif components.v20240608.cif.rdkit_mol.pkl clusters-by-entity-40.txt; do \
      echo ">>> baking data file: $f" && \
      curl -fL --retry 15 --retry-delay 20 --retry-max-time 1800 --retry-all-errors \
        --connect-timeout 30 \
        -o "$f.tmp" \
        "https://pxdesign.tos-cn-beijing.volces.com/release_data/$f" && \
      mv "$f.tmp" "$f" && \
      echo "$f: $(du -h "$f" | cut -f1)"; \
    done && \
    echo "Inference data caches baked: $(ls -lh $PXDESIGN_DIR/release_data/ccd_cache/)"

# Tell pxdesign where to find the pre-baked CCD cache. (load_checkpoint_dir is
# resolved via cwd=PXDESIGN_DIR at runtime; no env override needed for it.)
ENV PROTENIX_DATA_ROOT_DIR=$PXDESIGN_DIR/release_data/ccd_cache

# ---------- Pipeline utilities ----------
RUN python3 -m pip install --no-cache-dir \
    gemmi \
    requests

# ---------- Smoke-test fixture (PD-L1 IgV, chain A, residues 18-132) ----------
# See docs/SMOKE-TEST-SPEC.md. When JOB_PAYLOAD has tier=smoke|mini_pilot and no
# input_pdb_url, run_pipeline.py reads this baked target instead of downloading.
COPY backend/tests/fixtures/target_pdl1.pdb /opt/smoke_target.pdb

# ---------- Layer 1: fail-fast build-time checks ----------
# If any check fails here, `modal deploy` aborts before any GPU-minute is spent.
#   1. Every Python package the pipeline imports.
#   2. Every weight file / fixture exists.
#   3. PXDesign CLI on $PATH.
# JAX JIT is primed separately below (needs an active CUDA device at build time
# which is not available in Modal's CPU builder — deferred to preflight).
RUN python3 -c "import protenix; print('protenix OK')" && \
    python3 -c "import pxdesign; print('pxdesign OK')" && \
    python3 -c "import jax; print('jax', jax.__version__)" && \
    python3 -c "import torch; assert torch.__version__.startswith('2.3'), torch.__version__; print('torch', torch.__version__)" && \
    python3 -c "import deepspeed; assert deepspeed.__version__.startswith('0.12'), deepspeed.__version__; print('deepspeed', deepspeed.__version__)" && \
    python3 -c "from protenix.model.protenix import Protenix; print('Protenix model importable')" && \
    python3 -c "import yaml, gemmi, requests, numpy, biopython" 2>/dev/null || python3 -c "import yaml, gemmi, requests, numpy; from Bio import PDB; print('yaml/gemmi/requests/numpy/biopython OK')" && \
    test -f /opt/smoke_target.pdb && echo "smoke_target OK" && \
    test -d $PXDESIGN_DIR/tool_weights/af2 && echo "af2 weights OK" && \
    test -d $PXDESIGN_DIR/tool_weights/mpnn/vanilla_model_weights && echo "mpnn weights OK" && \
    test -d $PXDESIGN_DIR/tool_weights/mpnn/ca_model_weights && echo "mpnn ca weights OK" && \
    test -f $PXDESIGN_DIR/tool_weights/ccd/components.cif && echo "ccd OK" && \
    test -f $PXDESIGN_DIR/tool_weights/ccd/clusters-by-entity-40.txt && echo "clusters OK" && \
    test -f $PXDESIGN_DIR/release_data/checkpoint/pxdesign_v0.1.0.pt && echo "pxdesign ckpt OK" && \
    test -f $PXDESIGN_DIR/release_data/checkpoint/protenix_base_default_v0.5.0.pt && echo "protenix base ckpt OK" && \
    test -f $PXDESIGN_DIR/release_data/checkpoint/protenix_mini_default_v0.5.0.pt && echo "protenix mini ckpt OK" && \
    test -f $PXDESIGN_DIR/release_data/checkpoint/protenix_mini_tmpl_v0.5.0.pt && echo "protenix mini tmpl ckpt OK" && \
    test -f $PXDESIGN_DIR/release_data/ccd_cache/components.v20240608.cif && echo "ccd v20240608 OK" && \
    test -f $PXDESIGN_DIR/release_data/ccd_cache/components.v20240608.cif.rdkit_mol.pkl && echo "ccd rdkit pkl OK" && \
    test -f $PXDESIGN_DIR/release_data/ccd_cache/clusters-by-entity-40.txt && echo "pdb cluster v0.5 OK" && \
    which pxdesign && echo "pxdesign CLI on PATH"

# NOTE: no COPY run_pipeline.py or CMD — Modal invokes @app.function bodies.
