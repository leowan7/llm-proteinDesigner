# Modal variant of docker/rfdiffusion/Dockerfile.
# Diff vs production:
#   - All `wget -q` (weight + model downloads) -> `curl -fsSL --retry 5 --retry-delay 10`
#   - No COPY run_pipeline.py; no CMD; no WORKDIR /opt.
FROM runpod/base:0.6.2-cuda11.8.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/opt/rfdiffusion" \
    MODELS_DIR=/opt/rfdiffusion/models \
    COLABFOLD_CACHE_DIR=/opt/colabfold_weights \
    COLABFOLD_CACHE=/opt/colabfold_weights

# ---------- System deps ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git cmake python3-pip python3-dev build-essential && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# ---------- PyTorch + DGL ----------
# PyTorch 2.2.2+cu118 uses cuDNN 8, matching JAX 0.4.23 requirements.
RUN python3 -m pip install --no-cache-dir \
    torch==2.2.2 torchvision==0.17.2 \
    --index-url https://download.pytorch.org/whl/cu118 && \
    python3 -m pip install --no-cache-dir torchdata==0.7.1 && \
    python3 -m pip install --no-cache-dir dgl -f https://data.dgl.ai/wheels/torch-2.2/cu118/repo.html
RUN find / -xdev -uid +65533 -exec chown root:root {} + 2>/dev/null || true

# ---------- RFdiffusion + SE3Transformer (PINNED 2026-08-05) ----------
# Was `git clone --depth 1 ...` with no ref: the deployed image held whatever
# `main` happened to be on its build date and nobody could say what that was.
# Pinned to upstream main HEAD as of 2026-08-05 ("Fix github workflow tests",
# #458, 2026-07-15). Follows the docker/pxdesign/Dockerfile.modal ARG pattern.
#
# NOT pinned to tag v1.1.0 on purpose — that tag is from April 2023 and sits
# 96 commits behind this SHA. Pinning to it would be a three-year rollback of
# the code the tool has actually been running.
#
# Editing this file busts modal.Image.from_dockerfile's content-hash cache
# (infrastructure/modal/rfdiffusion_app.py:78-79) and forces a rebuild, which
# is what MOVES RFdiffusion from its unknown previous commit to this one.
# Re-pin only after a smoke run passes on the rebuilt image.
ARG RFDIFFUSION_SHA=86507b6538f51fce57b5a72477165f03999ed7ae
RUN git clone https://github.com/RosettaCommons/RFdiffusion.git /opt/rfdiffusion && \
    cd /opt/rfdiffusion && git checkout $RFDIFFUSION_SHA && \
    echo "RFdiffusion pinned to $(git rev-parse HEAD)" && \
    cd /opt/rfdiffusion/env/SE3Transformer && \
    python3 -m pip install --no-cache-dir -r requirements.txt && \
    python3 setup.py install && \
    cd /opt/rfdiffusion && \
    python3 -m pip install --no-cache-dir -e . && \
    python3 -m pip install --no-cache-dir hydra-core omegaconf pyrsistent e3nn opt_einsum
RUN find / -xdev -uid +65533 -exec chown root:root {} + 2>/dev/null || true

# ---------- RFdiffusion weights — PATCHED: curl with retries ----------
RUN mkdir -p $MODELS_DIR && \
    curl -fsSL --retry 5 --retry-delay 10 \
        http://files.ipd.uw.edu/pub/RFdiffusion/6f5902ac237024bdd0c176cb93063dc4/Base_ckpt.pt \
        -o $MODELS_DIR/Base_ckpt.pt && \
    curl -fsSL --retry 5 --retry-delay 10 \
        http://files.ipd.uw.edu/pub/RFdiffusion/e29311f6f1bf1af907f9ef9f44b8328b/Complex_base_ckpt.pt \
        -o $MODELS_DIR/Complex_base_ckpt.pt && \
    curl -fsSL --retry 5 --retry-delay 10 \
        http://files.ipd.uw.edu/pub/RFdiffusion/5532d2e1f3a4738decd58b19d633b3c3/ActiveSite_ckpt.pt \
        -o $MODELS_DIR/ActiveSite_ckpt.pt
RUN find / -xdev -uid +65533 -exec chown root:root {} + 2>/dev/null || true

# ---------- ProteinMPNN + weights — PATCHED: curl with retries ----------
# PINNED 2026-08-05, same rationale as RFdiffusion above. This SHA is
# upstream main HEAD ("updating solubleMPNN weights...", 2023-06-27); the
# repo has been effectively frozen since, so the pin costs nothing today and
# stops a future upstream push from silently changing the sequence-design
# stage of a deployed image.
ARG PROTEINMPNN_SHA=8907e6671bfbfc92303b5f79c4b5e6ce47cdef57
RUN git clone https://github.com/dauparas/ProteinMPNN.git /opt/ProteinMPNN && \
    cd /opt/ProteinMPNN && git checkout $PROTEINMPNN_SHA && \
    echo "ProteinMPNN pinned to $(git rev-parse HEAD)" && \
    mkdir -p /opt/ProteinMPNN/vanilla_model_weights && \
    curl -fsSL --retry 5 --retry-delay 10 \
        https://github.com/dauparas/ProteinMPNN/raw/$PROTEINMPNN_SHA/vanilla_model_weights/v_48_020.pt \
        -o /opt/ProteinMPNN/vanilla_model_weights/v_48_020.pt
RUN find / -xdev -uid +65533 -exec chown root:root {} + 2>/dev/null || true

# ---------- ColabFold + AF2 weights ----------
# Pin nvidia-cudnn-cu11<9.0 so JAX 0.4.23 finds libcudnn.so.8.
RUN python3 -m pip install --no-cache-dir \
    "nvidia-cudnn-cu11<9.0" \
    "colabfold[alphafold]==1.5.5" \
    "jax[cuda11_pip]==0.4.23" \
    -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html && \
    python3 -c "from colabfold.download import download_alphafold_params; download_alphafold_params('alphafold2_multimer_v3')"
RUN find / -xdev -uid +65533 -exec chown root:root {} + 2>/dev/null || true

# ---------- Python utilities ----------
# pydantic is required by /opt/contracts (vendored from tools-hub/contracts/)
# which run_pipeline.py imports for ToolPayload validation.
RUN python3 -m pip install --no-cache-dir requests biopython pandas "pydantic>=2,<3"

# ---------- Bake PD-L1 smoke fixture (per SMOKE-TEST-SPEC.md) ----------
# Smoke/mini_pilot tiers use this instead of downloading from a URL.
COPY backend/tests/fixtures/target_pdl1.pdb /opt/smoke_target.pdb

# ---------- Layer 1: build-time fail-fast validation ----------
# Fails `modal deploy` cheaply (no GPU) if any piece of the pipeline is
# missing. See docs/SMOKE-TEST-SPEC.md section "Layer 1".
RUN python3 -c "import torch; assert torch.__version__.startswith('2.2'), torch.__version__" && \
    python3 -c "import dgl" && \
    python3 -c "import hydra, omegaconf, e3nn, opt_einsum, pyrsistent" && \
    python3 -c "import se3_transformer" && \
    python3 -c "import Bio.PDB, requests, pandas" && \
    python3 -c "import jax; import colabfold" && \
    test -f $MODELS_DIR/Base_ckpt.pt && \
    test -f $MODELS_DIR/Complex_base_ckpt.pt && \
    test -f $MODELS_DIR/ActiveSite_ckpt.pt && \
    test -f /opt/ProteinMPNN/vanilla_model_weights/v_48_020.pt && \
    test -f /opt/ProteinMPNN/protein_mpnn_run.py && \
    test -f /opt/ProteinMPNN/helper_scripts/parse_multiple_chains.py && \
    test -f /opt/ProteinMPNN/helper_scripts/assign_fixed_chains.py && \
    test -f /opt/rfdiffusion/scripts/run_inference.py && \
    test -f /opt/smoke_target.pdb && \
    which python3 && \
    which colabfold_batch && \
    echo "Layer 1 build-time validation: OK"

# NOTE: no COPY run_pipeline.py or CMD — Modal invokes @app.function bodies.
